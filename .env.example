# Pflicht: Google Places API (Sourcing neuer Leads)
GOOGLE_PLACES_API_KEY=

# Pflicht: Anthropic API (Scoring der Leads)
ANTHROPIC_API_KEY=

# Pflicht: Supabase (Speicherort - dasselbe Projekt wie das Dashboard)
# SUPABASE_URL: Project Settings -> API -> Project URL
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API Keys -> Legacy API Keys
#   -> service_role (beginnt mit "eyJ..."), NICHT der "anon"-Key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Instagram-Check (Risiko-Modul, siehe README) - Standard: aus
ENABLE_INSTAGRAM_CHECK=false

# Optional: nur setzen, wenn zusaetzlich weiter ins Google Sheet geschrieben
# werden soll (Backup/Uebergang). Im Normalfall leer lassen.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
